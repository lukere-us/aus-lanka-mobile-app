APP_NAME="Entertainment Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Marketplace settings (see config/marketplace.php)
MARKETPLACE_CURRENCY=LKR
MARKETPLACE_DISPLAY_TIMEZONE=Asia/Colombo
FRONTEND_URL=http://localhost:3000
API_TOKEN_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe!12345

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# XAMPP MySQL/MariaDB defaults: user root, empty password
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=entertainment_marketplace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payments (see config/payments.php). "fake" until the real gateway is chosen.
PAYMENT_GATEWAY=fake
ORDER_TTL_MINUTES=15
FAKE_GATEWAY_SECRET=change-me-local-fake-secret
