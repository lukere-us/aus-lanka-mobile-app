# Copy to .env.local (git-ignored) and adjust.

# Laravel API, including /api/v1. The website calls it from the server only, so the browser never sees it.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Set to true when the website is served over https (staging/production) so the sign-in cookie is https-only.
SESSION_COOKIE_SECURE=false
